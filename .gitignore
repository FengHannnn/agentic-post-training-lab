.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/

artifacts/checkpoints/*
artifacts/logs/*
artifacts/trajectories/*
artifacts/evaluations/
artifacts/baselines/*
!artifacts/baselines/sft-v2-phase3/
artifacts/baselines/sft-v2-phase3/*
!artifacts/baselines/sft-v2-phase3/manifest.json
data/raw/*
data/processed/*

!artifacts/checkpoints/.gitkeep
!artifacts/logs/.gitkeep
!artifacts/trajectories/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep

.env
.env.*
!.env.example

# V2 runtime evidence stays on disk; source, reports and release manifests are versioned.
/v2/artifacts/*
!/v2/artifacts/README.md
/v2/*.zip
/v2/local-validation.json
/v2/test-results.txt
/v2/.local/
